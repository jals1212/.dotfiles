# ── Test runner ──────────────────────────────────────
brew "bats-core"

# ── Fonts ────────────────────────────────────────────
cask "font-iosevka-term-nerd-font" if OS.mac?

# ── Terminal ─────────────────────────────────────────
cask "ghostty" if OS.mac?

# ── Window manager ───────────────────────────────────
cask "nikitabobko/tap/aerospace" if OS.mac?

# ── File associations ────────────────────────────────
brew "duti" if OS.mac? # sets VSCodium as default app for code/text files

# ── GUI Apps (casks are macOS-only) ──────────────────
cask "brave-browser" if OS.mac?
cask "keka" if OS.mac?
