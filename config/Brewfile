# Dotfiles — Brewfile
# Installed by `./dots update` (dotbot-brew runs `brew bundle` on this file)

# ── Taps ─────────────────────────────────────────────
# Homebrew refuses to load formulae/casks from a non-official tap until they are
# trusted (`brew trust`); `trusted:` does that on `brew bundle`. Each tap trusts
# only the items installed below, not the whole tap.
# trusted: engram, gentle-ai and gga formulae below come from this third-party tap
tap "gentleman-programming/tap", trusted: { formulae: ["engram", "gentle-ai", "gga"] }
# trusted: the aerospace cask below comes from this third-party tap
tap "nikitabobko/tap", trusted: { casks: ["aerospace"] } if OS.mac?
# trusted: the open-pencil cask below comes from this third-party tap
tap "open-pencil/tap", trusted: { casks: ["open-pencil"] } if OS.mac?

# ── Machine-local choices ────────────────────────────
# Read from ~/.config/zsh/local.zsh, not from the environment: brew strips
# non-HOMEBREW_ variables. DOTS_COMPONENTS (./dots components) lists the terminal
# components and editors to install: tmux, herdr-tui, herdr-core, herdr-app,
# ghostty, nvim, fresh, vscodium. A selection that was never recorded, or
# `none`, installs none of them.
dots_local_zsh = File.join(Dir.home, ".config/zsh/local.zsh")
dots_local = File.exist?(dots_local_zsh) ? File.read(dots_local_zsh) : ""
dots_components = dots_local[/^export DOTS_COMPONENTS="\$\{DOTS_COMPONENTS:-(.*)\}"$/, 1].to_s.split

# ── Core CLI ─────────────────────────────────────────
brew "bat"
brew "eza"
brew "fd"
brew "fzf"
brew "gh"
brew "git"
brew "mise"
brew "ripgrep"
brew "ast-grep"
brew "sd"
brew "zoxide"

# ── Terminal components (chosen with ./dots components) ─
# Herdr core has no Homebrew package: the official installer runs from
# config/install.conf.yaml, with the app cask too (the cask brings no core;
# on Linux the official app installer brings it).
if dots_components.include?("tmux")
  brew "tmux"
  brew "gitmux" # tmux status-line git module
end
brew "herdr" if dots_components.include?("herdr-tui") # Herdr TUI
cask "herdr-app" if OS.mac? && dots_components.include?("herdr-app") # Herdr desktop app (Apple silicon); separate from the TUI, agents not shared
cask "ghostty" if OS.mac? && dots_components.include?("ghostty")

# ── Editors (chosen with ./dots components; independent of each other) ─
if dots_components.include?("nvim")
  brew "neovim"
  brew "luarocks" # for neovim plugins
end
brew "fresh-editor" if dots_components.include?("fresh") # Fresh terminal editor
cask "vscodium" if OS.mac? && dots_components.include?("vscodium") # default GUI editor
brew "duti" if OS.mac? && dots_components.include?("vscodium") # sets VSCodium as default app for code/text files

# ── Shell enhancements ───────────────────────────────
brew "starship"

# ── Dev tools ────────────────────────────────────────
brew "actionlint"
brew "bottom"
brew "clang-format"
brew "dos2unix"
brew "dust"
brew "gping"
brew "jless"
brew "jq"
brew "lazydocker"
brew "lazygit"
brew "make"
brew "shellcheck"
brew "vhs"

# ── AI agents ────────────────────────────────────────
brew "gentleman-programming/tap/engram"
brew "gentleman-programming/tap/gentle-ai"
brew "gentleman-programming/tap/gga"
cask "claude-code@latest" if OS.mac?
cask "codex" if OS.mac?

# ── Remote access (Tailscale + Herdr Mobile) ─────────
brew "tailscale"

# ── Cloud CLIs ───────────────────────────────────────
# azure-cli and vercel moved from homebrew-core to casks (tap_migrations.json);
# a `brew` entry fails with "No available formula". Casks are macOS-only.
cask "azure-cli" if OS.mac?
brew "cloudflare-wrangler"
cask "vercel" if OS.mac?

# ── Misc ─────────────────────────────────────────────
brew "cbonsai"
brew "gphoto2"
brew "hidapi"
brew "mole" if OS.mac?

# ── Test runner ──────────────────────────────────────
brew "bats-core"

# ── Fonts ────────────────────────────────────────────
# Only the font chosen with ./dots font (DOTS_FONT, machine-local in
# ~/.config/zsh/local.zsh; jetbrains-mono by default), so `brew bundle cleanup`
# keeps the active font and drops the other one. Read from the file: brew
# strips non-HOMEBREW_ variables from the environment.
# The font cask stays declared whatever the components are: starship, tmux and
# Neovim glyphs need a Nerd Font in any terminal, `./dots font` installs it
# without Ghostty, and `brew bundle cleanup` must not drop it.
dots_font = dots_local[/^export DOTS_FONT="\$\{DOTS_FONT:-(.*)\}"$/, 1]
cask(dots_font == "iosevka" ? "font-iosevka-term-nerd-font" : "font-jetbrains-mono-nerd-font") if OS.mac?

# ── Window manager ───────────────────────────────────
cask "nikitabobko/tap/aerospace" if OS.mac?

# ── GUI Apps (casks are macOS-only) ──────────────────
cask "brave-browser" if OS.mac?
cask "keka" if OS.mac?
cask "microsoft-teams" if OS.mac?
cask "open-pencil/tap/open-pencil" if OS.mac?
cask "orbstack" if OS.mac?
cask "windows-app" if OS.mac?
