# Dotfiles — Ghostty Terminal
# Theme: linked via ~/.config/ghostty/themes/dots (managed by ./dots theme)
# Font: IosevkaTerm NF

# ── Font ──────────────────────────────────────────────
font-family = IosevkaTerm NF
font-size = 14

# ── Window ────────────────────────────────────────────
background-blur-radius = 20
background-opacity = 0.85
gtk-tabs-location = hidden
macos-titlebar-style = transparent
window-decoration = true
window-height = 100
window-padding-balance = true
window-padding-color = extend
window-step-resize = false
window-width = 100

# ── Shell & terminal behavior ────────────────────────
shell-integration = zsh
# Don't let ghostty rewrite the cursor shape; shell prompts stay consistent.
shell-integration-features = no-cursor
mouse-hide-while-typing = true
scrollback-limit = 1000000

# ── Quick terminal ────────────────────────
keybind = global:cmd+grave_accent=new_window
keybind = global:cmd+shift+grave_accent=new_window

# ── Theme ────────────────────────────────────────────
# The active flavor's palette is written to ~/.config/ghostty/themes/dots
# by `dots install` / `dots update`; this file references it natively.
theme = dots
custom-shader = shaders/cursor_smear.glsl

# ── Input ────────────────────────────────────────────
# Only the right Option key acts as Alt; left Option stays as macOS Option.
macos-option-as-alt = right

# Disable Ghostty native tab shortcuts without blocking panes/splits or tmux.
keybind = cmd+t=new_window
keybind = cmd+shift+BracketLeft=unbind
keybind = cmd+shift+BracketRight=unbind
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind
keybind = ctrl+shift+t=unbind
keybind = ctrl+shift+left=unbind
keybind = ctrl+shift+right=unbind
keybind = ctrl+page_up=unbind
keybind = ctrl+page_down=unbind
keybind = ctrl+shift+page_up=unbind
keybind = ctrl+shift+page_down=unbind
keybind = cmd+digit_1=unbind
keybind = cmd+digit_2=unbind
keybind = cmd+digit_3=unbind
keybind = cmd+digit_4=unbind
keybind = cmd+digit_5=unbind
keybind = cmd+digit_6=unbind
keybind = cmd+digit_7=unbind
keybind = cmd+digit_8=unbind
keybind = cmd+digit_9=unbind
keybind = alt+digit_1=unbind
keybind = alt+digit_2=unbind
keybind = alt+digit_3=unbind
keybind = alt+digit_4=unbind
keybind = alt+digit_5=unbind
keybind = alt+digit_6=unbind
keybind = alt+digit_7=unbind
keybind = alt+digit_8=unbind
keybind = alt+digit_9=unbind

# ── Copy/paste ───────────────────────────────────────
# Ghostty copies its own selection here; inside tmux, copy is handled by
# tmux (set-clipboard on + tmux-yank), so each layer copies what it owns.
# Don't clobber the clipboard on selection; require an explicit copy gesture.
copy-on-select = false
# Keep selection visible regardless of theme contrast.
selection-invert-fg-bg = true
# ctrl+shift+c copies if there's a selection, otherwise passes through.
keybind = performable:ctrl+shift+c=copy_to_clipboard
# cmd+c copies if there's a selection, otherwise passes through.
keybind = performable:super+c=copy_to_clipboard
