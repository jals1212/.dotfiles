# Dotfiles — Ghostty Terminal
# Theme: linked via ~/.config/ghostty/themes/dots (managed by ./dots theme)
# Font: machine-local, written to ~/.config/ghostty/font.conf by ./dots font

# ── Font ──────────────────────────────────────────────
font-size = 14
# font-family comes from font.conf (jetbrains-mono | iosevka; see ./dots font).
# Included files load after this whole file, so font.conf wins.
config-file = ?font.conf

# ── Window ────────────────────────────────────────────
background-blur-radius = 20
background-opacity = 0.85
macos-titlebar-style = transparent
window-decoration = true
window-height = 100
window-padding-balance = true
window-padding-color = extend
window-step-resize = false
window-width = 100

# ── Shell & terminal behavior ────────────────────────
shell-integration = zsh
# Don't let ghostty rewrite the cursor shape; shell prompts stay consistent.
shell-integration-features = no-cursor
mouse-hide-while-typing = true
scrollback-limit = 1000000

# ── Theme ────────────────────────────────────────────
# The active flavor's palette is written to ~/.config/ghostty/themes/dots
# by `dots install` / `dots update`; this file references it natively.
theme = dots
custom-shader = shaders/cursor_smear.glsl

# ── Input ────────────────────────────────────────────
# Only the right Option key acts as Alt; left Option stays as macOS Option.
macos-option-as-alt = right

# Ghostty's default cmd+left/right sends ^A/^E, and ^A is the herdr prefix.
# Send Home/End instead (zsh binds them in keymaps.zsh).
keybind = super+arrow_left=esc:[H
keybind = super+arrow_right=esc:[F

# ── Copy/paste ───────────────────────────────────────
# Ghostty copies its own selection here; inside tmux, copy is handled by
# tmux (set-clipboard on + tmux-yank), so each layer copies what it owns.
# Don't clobber the clipboard on selection; require an explicit copy gesture.
copy-on-select = false
# Keep selection visible regardless of theme contrast.
selection-invert-fg-bg = true
# ctrl+shift+c copies if there's a selection, otherwise passes through.
keybind = performable:ctrl+shift+c=copy_to_clipboard
# cmd+c copies if there's a selection, otherwise passes through.
keybind = performable:super+c=copy_to_clipboard
