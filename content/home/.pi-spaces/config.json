{
  "schema": "pi-spaces.config/v1",
  "default": "gentle",
  "profiles": {
    "gentle": {
      "home": "~/.gentle-shell/agent",
      "command": "gentle-shell --",
      "setup": "gentle-shell --home {home} setup",
      "spaceEnv": { "GENTLE_PI_CONFIG_HOME": "{home}/gentle-config" }
    }
  }
}
