{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "#8ba4b0",
          "template": "{{ .Path }} ",
          "options": {
            "style": "agnoster_short",
            "folder_separator_icon": "/"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#a292a3",
          "template": "-> {{ .HEAD }}{{ if .Working.Changed }}*{{ end }} ",
          "options": {
            "branch_icon": " ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          }
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "#87a987",
          "template": "{{ if .Full }}node {{ .Full }} {{ end }}"
        },
        {
          "type": "go",
          "style": "plain",
          "foreground": "#8ea4a2",
          "template": "{{ if .Full }}go {{ .Full }} {{ end }}"
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "#b6927b",
          "template": "{{ if .Full }}py {{ .Full }} {{ end }}"
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#c4b28a",
          "template": "{{ if gt .Ms 500 }}took {{ .FormattedMs }} {{ end }}",
          "options": {
            "threshold": 500,
            "style": "round"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "time",
          "style": "plain",
          "foreground": "#737c73",
          "template": "{{ .CurrentDate | date .Format }}",
          "options": {
            "time_format": "15:04"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#c4746e{{ else }}#87a987{{ end }}"
          ],
          "template": "󱗞 "
        }
      ]
    }
  ]
}
