{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "#1e66f5",
          "template": "{{ .Path }} ",
          "options": {
            "style": "agnoster_short",
            "folder_separator_icon": "/"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#8839ef",
          "template": "-> {{ .HEAD }}{{ if .Working.Changed }}*{{ end }} ",
          "options": {
            "branch_icon": " ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          }
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "#40a02b",
          "template": "{{ if .Full }}node {{ .Full }} {{ end }}"
        },
        {
          "type": "go",
          "style": "plain",
          "foreground": "#179299",
          "template": "{{ if .Full }}go {{ .Full }} {{ end }}"
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "#fe640b",
          "template": "{{ if .Full }}py {{ .Full }} {{ end }}"
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#df8e1d",
          "template": "{{ if gt .Ms 500 }}took {{ .FormattedMs }} {{ end }}",
          "options": {
            "threshold": 500,
            "style": "round"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "time",
          "style": "plain",
          "foreground": "#6c6f85",
          "template": "{{ .CurrentDate | date .Format }}",
          "options": {
            "time_format": "15:04"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#d20f39{{ else }}#40a02b{{ end }}"
          ],
          "template": "󰚌 "
        }
      ]
    }
  ]
}
