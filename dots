#!/bin/sh
# dots — POSIX sh dispatcher for the dotfiles manager
# Usage: ./dots <subcommand> [args...]
# Run ./dots help for a full command listing.
# First-run: ./dots itself auto-bootstraps (python3 + git + submodules + brew).

set -eu

# ---------------------------------------------------------------------------
# Compute REPO_ROOT as the directory containing this script (resolved).
# ---------------------------------------------------------------------------
REPO_ROOT="$(cd "$(dirname "$0")" && pwd)"
export REPO_ROOT

# ---------------------------------------------------------------------------
# Source shared libraries.
# ---------------------------------------------------------------------------
# shellcheck source=src/lib/log.sh
. "${REPO_ROOT}/src/lib/log.sh"
# shellcheck source=src/lib/detect.sh
. "${REPO_ROOT}/src/lib/detect.sh"
# shellcheck source=src/lib/header.sh
. "${REPO_ROOT}/src/lib/header.sh"
# shellcheck source=src/lib/tui.sh
. "${REPO_ROOT}/src/lib/tui.sh"

# ---------------------------------------------------------------------------
# _dots_help
#   Print usage summary and exit 0.
# ---------------------------------------------------------------------------
_dots_help() {
    printf 'dots - dotfiles manager\n\n' >&2
    printf 'USAGE\n' >&2
    printf '  ./dots <subcommand> [flags]\n\n' >&2
    printf 'SUBCOMMANDS\n' >&2
    printf '  update      Run ./install (base dotbot) then apply active theme.\n' >&2
    printf '  sync        Re-run base dotbot + reapply manifest theme.\n' >&2
    printf '  theme       Switch the active theme/flavor.\n' >&2
    printf '  doctor      Non-mutating health checks.\n' >&2
    printf '  clean       Remove dead symlinks + stale dotbot-backup files.\n' >&2
    printf '  upgrade     Bump vendored deps; brew cleanup; mise prune.\n' >&2
    printf '  uninstall   Remove every dotbot-managed symlink and manifest.\n' >&2
    printf '  help        Show this message.\n\n' >&2
    printf 'FLAGS (per subcommand)\n' >&2
    printf '  --help / -h   Show subcommand usage.\n\n' >&2
    printf 'FIRST RUN\n' >&2
    printf '  ./dots            Auto-runs update when manifest.json is missing.\n' >&2
    printf '  ./dots            Auto-bootstraps on first run (installs python3 + brew).\n' >&2
}

# ---------------------------------------------------------------------------
# _dots_run <cmd> [args...]
#   Dispatches a single subcommand. Returns the subcommand's exit status.
#   Use DOTS_MENU_DISPATCH=1 in the env to suppress duplicate subcommand
#   banners when invoked from the interactive menu loop.
# ---------------------------------------------------------------------------
_dots_run() {
    _drun_cmd="${1}"
    shift
    case "${_drun_cmd}" in
        update)    sh "${REPO_ROOT}/src/commands/update.sh"    "$@" ;;
        sync)      sh "${REPO_ROOT}/src/commands/sync.sh"      "$@" ;;
        theme)     sh "${REPO_ROOT}/src/commands/theme.sh"     "$@" ;;
        doctor)    sh "${REPO_ROOT}/src/commands/doctor.sh"    "$@" ;;
        clean)     sh "${REPO_ROOT}/src/commands/clean.sh"     "$@" ;;
        upgrade)   sh "${REPO_ROOT}/src/commands/upgrade.sh"   "$@" ;;
        uninstall) sh "${REPO_ROOT}/src/commands/uninstall.sh" "$@" ;;
        help|-h|--help) _dots_help ;;
        quit) return 0 ;;
        *)
            log_error "Unknown command: ${_drun_cmd}"
            _dots_help
            return 2
            ;;
    esac
}

# ---------------------------------------------------------------------------
# _dots_pause
#   Block until user presses enter, so subcommand output is readable before
#   the next clear+redraw of the menu. Set DOTS_NO_PAUSE=1 to skip (tests).
# ---------------------------------------------------------------------------
_dots_pause() {
    [ "${DOTS_NO_PAUSE:-0}" = "1" ] && return 0
    printf '\n[ press enter to return to menu ]\n' >&2
    IFS= read -r _ </dev/tty || true
}

# ---------------------------------------------------------------------------
# Dispatcher
# ---------------------------------------------------------------------------
if [ "$#" -eq 0 ]; then
    if [ ! -f "${REPO_ROOT}/manifest.json" ]; then
        sh "${REPO_ROOT}/src/commands/update.sh"
        exit $?
    fi
    if [ -t 0 ] && [ -t 1 ]; then
        export DOTS_MENU_DISPATCH=1
        _last=""
        while :; do
            clear 2>/dev/null || true
            render_command_banner ""
            cmd="$(render_action_menu "${_last}" || true)"
            [ -z "${cmd}" ] && exit 0
            [ "${cmd}" = "quit" ] && exit 0
            _dots_run "${cmd}" || true
            _last="${cmd}"
            _dots_pause
        done
    else
        log_error "non-interactive './dots' requires a subcommand. See './dots help'."
        exit 2
    fi
fi

_dots_run "$@"
exit $?
