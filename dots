#!/bin/sh
# dots — POSIX sh dispatcher for the dotfiles manager
# Usage: ./dots <subcommand> [args...]
# Run ./dots help for a full command listing.
# First-run: use ./bootstrap.sh to install dependencies and configure the system.

set -eu

# ---------------------------------------------------------------------------
# Compute REPO_ROOT as the directory containing this script (resolved).
# ---------------------------------------------------------------------------
REPO_ROOT="$(cd "$(dirname "$0")" && pwd)"
export REPO_ROOT

# ---------------------------------------------------------------------------
# Source shared libraries.
# ---------------------------------------------------------------------------
# shellcheck source=lib/log.sh
. "${REPO_ROOT}/lib/log.sh"
# shellcheck source=lib/detect.sh
. "${REPO_ROOT}/lib/detect.sh"
# shellcheck source=lib/header.sh
. "${REPO_ROOT}/lib/header.sh"
# shellcheck source=lib/tui.sh
. "${REPO_ROOT}/lib/tui.sh"

# ---------------------------------------------------------------------------
# _dots_help
#   Print usage summary and exit 0.
# ---------------------------------------------------------------------------
_dots_help() {
    printf 'dots - dotfiles manager\n\n' >&2
    printf 'USAGE\n' >&2
    printf '  ./dots <subcommand> [flags]\n\n' >&2
    printf 'SUBCOMMANDS\n' >&2
    printf '  update      Configure theme/tools, then deploy immediately.\n' >&2
    printf '  sync        Apply/reconcile existing manifest config (or --force).\n' >&2
    printf '  backup      Create an explicit backup of managed dotfiles.\n' >&2
    printf '  restore     Restore a backup: --latest or an explicit path.\n' >&2
    printf '  uninstall   Remove managed config files and manifest.json.\n' >&2
    printf '  doctor      Non-mutating health checks on deployed dotfiles.\n' >&2
    printf '  help        Show this message.\n\n' >&2
    printf 'FLAGS (per subcommand)\n' >&2
    printf '  --help / -h   Show subcommand usage.\n\n' >&2
    printf 'FIRST RUN\n' >&2
    printf '  ./dots            Auto-runs update when manifest.json is missing.\n' >&2
    printf '  ./bootstrap.sh    Install dependencies (Homebrew, Brewfile) and run update.\n' >&2
}

# ---------------------------------------------------------------------------
# _dots_run <cmd> [args...]
#   Dispatches a single subcommand. Returns the subcommand's exit status.
#   Use DOTS_MENU_DISPATCH=1 in the env to suppress duplicate subcommand
#   banners when invoked from the interactive menu loop.
# ---------------------------------------------------------------------------
_dots_run() {
    _drun_cmd="${1}"
    shift
    case "${_drun_cmd}" in
        update)    sh "${REPO_ROOT}/commands/update.sh"    "$@" ;;
        sync)      sh "${REPO_ROOT}/commands/sync.sh"      "$@" ;;
        backup)    sh "${REPO_ROOT}/commands/backup.sh"    "$@" ;;
        doctor)    sh "${REPO_ROOT}/commands/doctor.sh"    "$@" ;;
        restore)   sh "${REPO_ROOT}/commands/restore.sh"   "$@" ;;
        uninstall) sh "${REPO_ROOT}/commands/uninstall.sh" "$@" ;;
        help|-h|--help) _dots_help ;;
        quit) return 0 ;;
        *)
            log_error "Unknown command: ${_drun_cmd}"
            _dots_help
            return 2
            ;;
    esac
}

# ---------------------------------------------------------------------------
# _dots_pause
#   Block until user presses enter, so subcommand output is readable before
#   the next clear+redraw of the menu. Set DOTS_NO_PAUSE=1 to skip (tests).
# ---------------------------------------------------------------------------
_dots_pause() {
    [ "${DOTS_NO_PAUSE:-0}" = "1" ] && return 0
    printf '\n[ press enter to return to menu ]\n' >&2
    IFS= read -r _ </dev/tty || true
}

# ---------------------------------------------------------------------------
# Dispatcher
# ---------------------------------------------------------------------------
if [ "$#" -eq 0 ]; then
    if [ ! -f "${REPO_ROOT}/manifest.json" ]; then
        sh "${REPO_ROOT}/commands/update.sh"
        exit $?
    fi
    if [ -t 0 ] && [ -t 1 ]; then
        export DOTS_MENU_DISPATCH=1
        _last=""
        while :; do
            clear 2>/dev/null || true
            render_command_banner ""
            cmd="$(render_action_menu "${_last}" || true)"
            [ -z "${cmd}" ] && exit 0
            [ "${cmd}" = "quit" ] && exit 0
            _dots_run "${cmd}" || true
            _last="${cmd}"
            _dots_pause
        done
    else
        log_error "non-interactive './dots' requires a subcommand. See './dots help'."
        exit 2
    fi
fi

_dots_run "$@"
exit $?
