#!/usr/bin/env sh
# src/install — dotbot wrapper
# Resolves REPO_ROOT (one level up from this script) and invokes dotbot with
# the dotbot-brew and dotbot-mise plugins. Usage: src/install [config.yaml]
# (default: config/install.conf.yaml, resolved relative to REPO_ROOT).

set -e

# Resolve SELF following symlinks, then REPO_ROOT (one level up from src/).
SELF="$0"
while [ -L "$SELF" ]; do
  SELF_DIR="$(cd "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  case "$SELF" in
    /*) ;;
    *) SELF="${SELF_DIR}/${SELF}" ;;
  esac
done
REPO_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"

CONFIG="${1:-${REPO_ROOT}/config/install.conf.yaml}"

# Ensure brew install locations are on PATH so dotbot-brew finds `brew`
# after the shell directive installs it (Python subprocesses inherit PATH
# from this wrapper, not from in-run shell directive exports).
PATH="/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin:${PATH}"
export PATH

# ── Preflight ──────────────────────────────────────────────────────────────

if ! command -v python3 >/dev/null 2>&1; then
  printf 'error: python3 not found on PATH.\n' >&2
  printf '  macOS:          xcode-select --install\n' >&2
  printf '  Debian/Ubuntu:  sudo apt-get install -y python3\n' >&2
  printf '  Fedora:         sudo dnf install -y python3\n' >&2
  exit 1
fi

if [ ! -x "${REPO_ROOT}/vendor/dotbot/bin/dotbot" ]; then
  printf 'error: dotbot submodule not initialized.\n' >&2
  printf '  Run: git submodule update --init --recursive\n' >&2
  exit 1
fi

if [ ! -f "${REPO_ROOT}/vendor/plugins/dotbot-brew/brew.py" ] || \
   [ ! -f "${REPO_ROOT}/vendor/plugins/dotbot-mise/mise.py" ]; then
  printf 'error: plugin submodules not initialized.\n' >&2
  printf '  Run: git submodule update --init --recursive\n' >&2
  exit 1
fi

# ── Invoke dotbot ──────────────────────────────────────────────────────────

python3 "${REPO_ROOT}/vendor/dotbot/bin/dotbot" \
  --plugin "${REPO_ROOT}/vendor/plugins/dotbot-brew/brew.py" \
  --plugin "${REPO_ROOT}/vendor/plugins/dotbot-mise/mise.py" \
  -d "${REPO_ROOT}" \
  -c "${CONFIG}"
